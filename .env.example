# Создавать .env для первого запуска через Run-TestPilot.bat не требуется.
# При отсутствии значений Compose использует настройки для локальной демонстрации.
POSTGRES_USER=testpilot
POSTGRES_DB=testpilot
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://testpilot:CHANGE_ME@localhost:5432/testpilot
TP_ANALYST_PASSWORD=
TP_EXPERT_PASSWORD=
TP_RUNNER_PASSWORD=
IMPACT_URL=http://127.0.0.1:8001
INTELLIGENCE_URL=http://127.0.0.1:8002

# Необязательная read-only диагностика реальной 1С; URL без паролей и query.
TP_1C_ODATA_URL=
TP_1C_WEB_URL=
# Один способ входа: username/password ИЛИ полный Authorization из защищённой среды.
TP_1C_USERNAME=
TP_1C_PASSWORD=
TP_1C_AUTHORIZATION=
# Необязательный CA-файл для доверенного корпоративного сертификата; TLS не отключается.
TP_1C_CA_FILE=

# Внешняя нейросеть: ключ только на сервере. Не использовать API-ключ подписки ChatGPT.
TP_LLM_BASE_URL=https://api.openai.com/v1
TP_LLM_MODEL=gpt-4.1-mini
TP_LLM_API_KEY=
# Необязательно: Windows использует Chromium Playwright, Linux — /usr/bin/chromium.
TP_CHROMIUM_PATH=
WEB_URL=http://127.0.0.1:8000
