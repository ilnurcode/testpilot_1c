# Создавать .env для первого запуска через Run-TestPilot.bat не требуется.
# При отсутствии значений Compose использует настройки для локальной демонстрации.
POSTGRES_USER=testpilot
POSTGRES_DB=testpilot
POSTGRES_PASSWORD=
# Строка подключения для host-запуска и тестов; в Compose собирается из POSTGRES_*.
DATABASE_URL=postgresql+psycopg://testpilot:CHANGE_ME@localhost:5432/testpilot
# Три роли Basic Auth: пароли читаются сервисами из окружения, в логи не попадают.
TP_ANALYST_PASSWORD=
TP_EXPERT_PASSWORD=
TP_RUNNER_PASSWORD=
# Схема API и /docs закрыты Basic Auth. 1 открывает /docs, /redoc и /openapi.json без креды — ТОЛЬКО ЛОКАЛЬНО.
TP_OPENAPI_PUBLIC=
# Настройки LLM из UI по умолчанию живут только в памяти процесса. Запись в файл окружения — явный opt-in:
# TP_ALLOW_ENV_WRITE=1 разрешает запись, TP_ENV_FILE задаёт путь (по умолчанию .env).
TP_ALLOW_ENV_WRITE=
TP_ENV_FILE=
IMPACT_URL=http://127.0.0.1:8001
# Предел детализации замечаний аудита (100..20000, по умолчанию 5000). Больше — больше JSON
# в code_audit.issues и audit_result загрузок; полный счётчик total_issues от предела не зависит.
# Значение вне диапазона или не число останавливает запуск сервиса с сообщением об ошибке.
TP_AUDIT_MAX_ISSUES=5000
INTELLIGENCE_URL=http://127.0.0.1:8002

# Необязательная read-only диагностика реальной 1С; URL без паролей и query.
TP_1C_ODATA_URL=
TP_1C_WEB_URL=
# Один способ входа: username/password ИЛИ полный Authorization из защищённой среды.
TP_1C_USERNAME=
TP_1C_PASSWORD=
TP_1C_AUTHORIZATION=
# Необязательный CA-файл для доверенного корпоративного сертификата; TLS не отключается.
TP_1C_CA_FILE=

# Независимый OpenAI-совместимый API: ключ только на сервере.
# Подписка ChatGPT не является API-ключом; для неё используйте Codex ниже.
TP_LLM_BASE_URL=https://api.openai.com/v1
TP_LLM_MODEL=gpt-4.1-mini
TP_LLM_API_KEY=

# Codex CLI: ChatGPT sign-in без API-ключа. В Docker CLI 0.167.2 уже установлен.
# Вход/выход — в UI; Docker хранит credentials только в отдельном named volume intelligence.
TP_CODEX_BIN=codex
# Пустое значение оставляет модель по умолчанию для учётной записи Codex.
TP_CODEX_MODEL=
TP_CODEX_TIMEOUT_SECONDS=180
# Каталог состояния Codex CLI; Docker задаёт /var/lib/testpilot/codex, host может указать свой.
CODEX_HOME=
# Docker задаёт CODEX_HOME=/var/lib/testpilot/codex независимо от host.
# Для host задайте отдельный абсолютный CODEX_HOME перед login и запуском intelligence.
# Необязательно: Windows использует Chromium Playwright, Linux — /usr/bin/chromium.
TP_CHROMIUM_PATH=
WEB_URL=http://127.0.0.1:8000
