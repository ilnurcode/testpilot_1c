{
  "$defs": {
    "Case": {
      "additionalProperties": true,
      "properties": {
        "quantity": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "price": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "discount": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discount"
        },
        "expected_total": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Total"
        },
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "fields": {
          "additionalProperties": true,
          "title": "Fields",
          "type": "object"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "steps": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Steps",
          "type": "array"
        },
        "assertions": {
          "items": {
            "$ref": "ai-assertion-1.0.schema.json"
          },
          "maxItems": 12,
          "title": "Assertions",
          "type": "array"
        }
      },
      "title": "Case",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Title",
          "type": "string"
        },
        "rationale": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Rationale",
          "type": "string"
        },
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "object_ids": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[\\w.:-]+$",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Object Ids",
          "type": "array"
        },
        "steps": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f]+$",
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "expected_result": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Expected Result",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/Case"
          },
          "maxItems": 3,
          "title": "Cases",
          "type": "array"
        }
      },
      "required": [
        "title",
        "rationale",
        "engine",
        "object_ids",
        "steps",
        "expected_result"
      ],
      "title": "Proposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "summary": {
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f]+$",
      "title": "Summary",
      "type": "string"
    },
    "selected_test_ids": {
      "items": {
        "maxLength": 120,
        "minLength": 1,
        "pattern": "^[\\w.:-]+$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Selected Test Ids",
      "type": "array"
    },
    "proposals": {
      "items": {
        "$ref": "#/$defs/Proposal"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Proposals",
      "type": "array"
    },
    "warnings": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f]+$",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "proposals"
  ],
  "title": "Suggestion (план проверок 1С)",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-suggestion-1.0.schema.json"
}
