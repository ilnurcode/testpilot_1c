# Opt-in only. Keep TP_PORTABLE_SECRET_HOST_FILE outside this checkout and .env.
# Example:
#   set TP_PORTABLE_SECRET_HOST_FILE=C:\secure\testpilot-connection.key
#   docker compose -f compose.yaml -f compose.portable-secrets.yaml.example up --build --wait
services:
  impact:
    environment:
      TP_SECRET_PROTECTOR: portable
      TP_PORTABLE_SECRET_KEY_FILE: /run/secrets/testpilot_connection_key
    secrets:
      - source: testpilot_connection_key
        target: testpilot_connection_key
        mode: 0400
  intelligence:
    environment:
      TP_SECRET_PROTECTOR: portable
      TP_PORTABLE_SECRET_KEY_FILE: /run/secrets/testpilot_connection_key
    secrets:
      - source: testpilot_connection_key
        target: testpilot_connection_key
        mode: 0400

secrets:
  testpilot_connection_key:
    file: ${TP_PORTABLE_SECRET_HOST_FILE:?Set an absolute external portable key-file path}
