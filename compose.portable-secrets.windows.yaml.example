# Opt-in override для Docker Desktop на Windows (Linux containers).
#
# NOTE (WIP): не проверено — прогонов и реального `docker compose up` с этим override нет.
# Монтирование допустимо только для нужного сервиса, который действительно использует ключ.
# Риск: образ не задаёт USER, процесс в контейнере — root, поэтому приватная копия ключа
# не изолирована от других процессов внутри контейнера; перед использованием определить
# UID/GID и проверить недоступность копии остальным, не ослабляя проверку в testpilot/secrets.py.
#
# Зачем: файл, смонтированный с Windows-хоста, приходит в контейнер с mode 0777 и
# чужим uid. Строгая проверка testpilot/secrets.py (владелец + отсутствие group/other)
# на таком источнике отказывает законно, ослаблять её нельзя. Поэтому источник
# монтируется read-only, entrypoint копирует ключ в приватный каталог на tmpfs с 0600
# и владельцем процесса, а приложение читает только копию.
#
# Требования к host-файлу: обычный файл (не каталог и не symlink), один 32-byte ключ
# в URL-safe base64, созданный явно:
#   python scripts\secrets_key.py --create-portable-key --key-file C:\secure\testpilot-connection.key --confirmed
# Храните файл вне checkout и .env; доступ к нему ограничивайте ACL Windows.
#
# Запуск:
#   set TP_PORTABLE_SECRET_HOST_FILE=C:\secure\testpilot-connection.key
#   docker compose -f compose.yaml -f compose.portable-secrets.windows.yaml.example up -d --wait
#
# Одна переменная окружения на оба издания: здесь — источник bind-монтирования, в
# compose.portable-secrets.yaml.example — файл для docker secrets.
services:
  impact:
    entrypoint: ["python", "/opt/testpilot-portable/portable_key_entrypoint.py"]
    environment:
      TP_SECRET_PROTECTOR: portable
      TP_PORTABLE_SECRET_KEY_SOURCE: /run/testpilot-key-source/connection.key
      TP_PORTABLE_SECRET_KEY_FILE: /run/testpilot/portable-connection.key
    tmpfs:
      - /run/testpilot:mode=0700,size=1m
    volumes:
      - type: bind
        source: ${TP_PORTABLE_SECRET_HOST_FILE:?Set an absolute external portable key-file path}
        target: /run/testpilot-key-source/connection.key
        read_only: true
      - type: bind
        source: ./scripts/portable_key_entrypoint.py
        target: /opt/testpilot-portable/portable_key_entrypoint.py
        read_only: true
  intelligence:
    entrypoint: ["python", "/opt/testpilot-portable/portable_key_entrypoint.py"]
    environment:
      TP_SECRET_PROTECTOR: portable
      TP_PORTABLE_SECRET_KEY_SOURCE: /run/testpilot-key-source/connection.key
      TP_PORTABLE_SECRET_KEY_FILE: /run/testpilot/portable-connection.key
    tmpfs:
      - /run/testpilot:mode=0700,size=1m
    volumes:
      - type: bind
        source: ${TP_PORTABLE_SECRET_HOST_FILE:?Set an absolute external portable key-file path}
        target: /run/testpilot-key-source/connection.key
        read_only: true
      - type: bind
        source: ./scripts/portable_key_entrypoint.py
        target: /opt/testpilot-portable/portable_key_entrypoint.py
        read_only: true
