# Сборка для среды, где Docker build не имеет внешнего DNS.
FROM python:3.12-slim
WORKDIR /app
COPY .wheelhouse /wheels
COPY pyproject.toml requirements.lock ./
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.lock setuptools wheel
COPY . .
RUN pip install --no-cache-dir --no-index --no-build-isolation --no-deps . && rm -rf /wheels /app/.wheelhouse
EXPOSE 8000 8001 8002
CMD ["uvicorn", "testpilot.web.api:app", "--host", "0.0.0.0", "--port", "8000"]
